{
  "name": "durismud-api",
  "version": "1.0.6",
  "description": "DurisMUD PvP Logs API - Express backend for serving PvP battle data",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "biome format --write src scripts seeds *.ts *.js package.json",
    "format:check": "biome format src scripts seeds *.ts *.js package.json",
    "type-check": "tsc --noEmit",
    "config:check": "NODE_OPTIONS='--import tsx' tsx src/scripts/checkEnvironment.ts",
    "verify:mud-writes": "NODE_OPTIONS='--import tsx' tsx src/scripts/verifyMudWriteAllowlist.ts",
    "verify:imported-item-baselines": "NODE_OPTIONS='--import tsx' tsx src/scripts/verifyImportedItemBaselines.ts",
    "verify:combat-baselines": "NODE_OPTIONS='--import tsx' tsx src/scripts/verifyCombatFragBaselines.ts",
    "verify:item-topology-attestation": "NODE_OPTIONS='--import tsx' tsx src/scripts/verifyItemTopologyAttestation.ts",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "migrate:make": "NODE_OPTIONS='--import tsx' knex migrate:make --knexfile knexfile.ts -x ts",
    "migrate:latest": "NODE_OPTIONS='--import tsx' knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "NODE_OPTIONS='--import tsx' knex migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "NODE_OPTIONS='--import tsx' knex migrate:status --knexfile knexfile.ts",
    "seed:make": "NODE_OPTIONS='--import tsx' knex seed:make --knexfile knexfile.ts -x ts",
    "seed:run": "NODE_OPTIONS='--import tsx' knex seed:run --knexfile knexfile.ts",
    "extract-map-data": "NODE_OPTIONS='--import tsx' tsx src/scripts/extractMapData.ts",
    "wiki:publish": "NODE_OPTIONS='--import tsx' tsx scripts/import-wiki-data.ts",
    "forum:bootstrap": "NODE_OPTIONS='--import tsx' tsx src/scripts/bootstrapForum.ts",
    "sync-flags": "NODE_OPTIONS='--import tsx' tsx src/scripts/syncBuilderFlags.ts"
  },
  "keywords": [
    "durismud",
    "pvp",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "overrides": {
      "@types/express-serve-static-core": "5.1.0"
    },
    "onlyBuiltDependencies": [
      "node-pty",
      "bcrypt",
      "esbuild"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@google/generative-ai": "^0.24.1",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dompurify": "^3.4.15",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "ioredis": "^5.11.1",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "node-cron": "^4.6.0",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.4",
    "tail": "^2.2.6",
    "unzipper": "^0.12.5",
    "uuid": "^13.0.2",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@jest/globals": "^30.5.1",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.3",
    "@types/tail": "^2.2.3",
    "@types/unzipper": "^0.10.11",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.1",
    "node-gyp": "^12.4.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
