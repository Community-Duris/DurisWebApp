#!/usr/bin/env bash
set -euo pipefail

render_script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
render_deploy_root=$(cd "${render_script_dir}/.." && pwd)

if [ "$#" -ne 1 ]; then
  printf 'Usage: %s /absolute/path/to/deployment.env\n' "$0" >&2
  exit 64
fi

render_input=$1
if [ ! -f "${render_input}" ] || [ -L "${render_input}" ]; then
  printf 'Deployment input must be a regular, non-symlink file: %s\n' "${render_input}" >&2
  exit 78
fi

render_input_mode=$(stat -c '%a' "${render_input}")
render_input_owner=$(stat -c '%u' "${render_input}")
if (( (8#${render_input_mode} & 0177) != 0 )) || [ "${render_input_owner}" != "$(id -u)" ]; then
  printf 'Deployment input must be owner-controlled with mode 0600.\n' >&2
  exit 78
fi

# Optional selections belong to this input, not the invoking shell environment.
DEPLOY_SERVICE_SCOPE=user
SERVICE_USER=''
NGINX_CANONICAL_ORIGIN=''
while IFS= read -r render_line || [ -n "${render_line}" ]; do
  case "${render_line}" in
    ''|'#'*) continue ;;
  esac
  if [[ ! "${render_line}" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]]; then
    printf 'Invalid deployment input line (expected KEY=value).\n' >&2
    exit 78
  fi
  printf -v "${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
done <"${render_input}"

SERVICE_IDENTITY=''
SERVICE_INSTALL_TARGET=default.target
SERVICE_REMOVE_IPC=true
case "${DEPLOY_SERVICE_SCOPE}" in
  user) ;;
  system)
    if [[ ! "${SERVICE_USER:-}" =~ ^[a-z_][a-z0-9_-]*$ ]] ||
      ! render_service_uid=$(id -u "${SERVICE_USER}" 2>/dev/null) ||
      [ "${render_service_uid}" = '0' ]; then
      printf 'System services require SERVICE_USER to name an existing non-root user.\n' >&2
      exit 78
    fi
    SERVICE_IDENTITY="User=${SERVICE_USER}"
    SERVICE_INSTALL_TARGET=multi-user.target
    # The deployment user may also own the MUD's IPC; do not remove shared IPC.
    SERVICE_REMOVE_IPC=false
    ;;
  *)
    printf 'DEPLOY_SERVICE_SCOPE must be user or system.\n' >&2
    exit 78
    ;;
esac

render_variables=(
  RENDER_OUTPUT_DIR BACKEND_ROOT FRONTEND_DIST BACKEND_ENV_FILE NODE_BIN TEST_BIN
  SERVICE_PATH LOCAL_HEALTH_URL APPLICATION_SERVICE CACHE_SERVICE
  DATABASE_SERVICE MUD_SERVICE REDIS_BIN REDIS_LIBRARY_PATH REDIS_CONFIG_PATH
  REDIS_DATA_DIR REDIS_BIND_ADDRESS REDIS_PORT REDIS_DATABASE_COUNT REDIS_MAX_MEMORY
  DEPLOY_CLOUDFLARED_ENABLED DEPLOY_NGINX_ENABLED
)

for render_flag in DEPLOY_CLOUDFLARED_ENABLED DEPLOY_NGINX_ENABLED; do
  if [ "${!render_flag:-}" != 'true' ] && [ "${!render_flag:-}" != 'false' ]; then
    printf 'Deployment flag must be true or false: %s\n' "${render_flag}" >&2
    exit 78
  fi
done

if [ "${DEPLOY_CLOUDFLARED_ENABLED}" = 'true' ]; then
  render_variables+=(
    DEPLOYMENT_ENV_FILE SERVICE_HOME CLOUDFLARED_BIN CLOUDFLARED_LAUNCHER
    CLOUDFLARED_METRICS_ADDRESS CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID
    CLOUDFLARE_WEB_TUNNEL_ID
  )
fi

if [ "${DEPLOY_NGINX_ENABLED}" = 'true' ]; then
  render_variables+=(
    NGINX_SERVICE NGINX_HTTP_LISTEN NGINX_HTTPS_LISTEN NGINX_SERVER_NAMES NGINX_BACKEND_UPSTREAM
    NGINX_ACME_ROOT NGINX_TLS_CERTIFICATE NGINX_TLS_CERTIFICATE_KEY
    NGINX_TLS_OPTIONS_INCLUDE NGINX_TLS_DHPARAM
  )
  if [ -n "${NGINX_CANONICAL_ORIGIN:-}" ]; then
    if [[ ! "${NGINX_CANONICAL_ORIGIN}" =~ ^https://[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$ ]]; then
      printf 'NGINX_CANONICAL_ORIGIN must be an HTTPS DNS origin without port, path, or trailing slash.\n' >&2
      exit 78
    fi
    render_variables+=(NGINX_CANONICAL_ORIGIN)
  fi
fi

if [ "${DEPLOY_CLOUDFLARED_ENABLED}" = 'true' ] || [ "${DEPLOY_NGINX_ENABLED}" = 'true' ]; then
  render_variables+=(PUBLIC_HEALTH_URL)
fi

for render_name in "${render_variables[@]}"; do
  if [ -z "${!render_name:-}" ]; then
    printf 'Missing required deployment value: %s\n' "${render_name}" >&2
    exit 78
  fi
  render_value=${!render_name,,}
  if [[ "${render_value}" == *change_me* || "${render_value}" == *change-me* ||
    "${render_value}" == *replace_with* || "${render_value}" == *example* ]]; then
    printf 'Replace placeholder deployment value: %s\n' "${render_name}" >&2
    exit 78
  fi
done

if [[ ! "${LOCAL_HEALTH_URL}" =~ ^http://(127\.0\.0\.1|localhost|\[::1\])(:[0-9]+)?/health$ ]]; then
  printf 'LOCAL_HEALTH_URL must be an exact loopback /health URL.\n' >&2
  exit 78
fi
if { [ "${DEPLOY_CLOUDFLARED_ENABLED}" = 'true' ] || [ "${DEPLOY_NGINX_ENABLED}" = 'true' ]; } &&
  { [[ ! "${PUBLIC_HEALTH_URL}" =~ ^https://[^/?#[:space:]]+/health$ ]] ||
    [[ "${PUBLIC_HEALTH_URL}" == *@* ]]; }; then
  printf 'PUBLIC_HEALTH_URL must be an exact HTTPS /health URL when public ingress is enabled.\n' >&2
  exit 78
fi
render_services=(APPLICATION_SERVICE CACHE_SERVICE)
if [ "${DEPLOY_NGINX_ENABLED}" = 'true' ]; then
  render_services+=(NGINX_SERVICE)
fi
for render_service in "${render_services[@]}"; do
  if [[ ! "${!render_service}" =~ ^[A-Za-z0-9_.@:-]+\.service$ ]]; then
    printf 'Invalid systemd service name: %s\n' "${render_service}" >&2
    exit 78
  fi
done

render_output_marker="${RENDER_OUTPUT_DIR}/.durisweb-render-output"
render_variables+=(SERVICE_IDENTITY SERVICE_INSTALL_TARGET SERVICE_REMOVE_IPC)
if [[ "${RENDER_OUTPUT_DIR}" != /* ]] ||
  [ "$(realpath -m -- "${RENDER_OUTPUT_DIR}")" != "${RENDER_OUTPUT_DIR}" ]; then
  printf 'Render output must be an absolute path without symlinked components: %s\n' \
    "${RENDER_OUTPUT_DIR}" >&2
  exit 78
fi
if [ ! -d "${RENDER_OUTPUT_DIR}" ] || [ -L "${RENDER_OUTPUT_DIR}" ]; then
  printf 'Render output must be an existing non-symlink directory: %s\n' \
    "${RENDER_OUTPUT_DIR}" >&2
  exit 78
fi
if [ "$(stat -c '%u' "${RENDER_OUTPUT_DIR}")" != "$(id -u)" ]; then
  printf 'Render output must be owned by the current user: %s\n' "${RENDER_OUTPUT_DIR}" >&2
  exit 78
fi
if [ ! -e "${render_output_marker}" ] &&
  [ -n "$(find "${RENDER_OUTPUT_DIR}" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
  printf 'Refusing non-empty directory without a DurisWeb render marker: %s\n' \
    "${RENDER_OUTPUT_DIR}" >&2
  exit 78
fi
if [ -e "${render_output_marker}" ] || [ -L "${render_output_marker}" ]; then
  if [ ! -f "${render_output_marker}" ] || [ -L "${render_output_marker}" ] ||
    [ "$(stat -c '%u' "${render_output_marker}")" != "$(id -u)" ]; then
    printf 'Invalid DurisWeb render marker: %s\n' "${render_output_marker}" >&2
    exit 78
  fi
fi
for render_subdirectory in systemd redis nginx; do
  render_subdirectory_path="${RENDER_OUTPUT_DIR}/${render_subdirectory}"
  if [ -e "${render_subdirectory_path}" ] || [ -L "${render_subdirectory_path}" ]; then
    if [ ! -d "${render_subdirectory_path}" ] || [ -L "${render_subdirectory_path}" ] ||
      [ "$(stat -c '%u' "${render_subdirectory_path}")" != "$(id -u)" ]; then
      printf 'Invalid render output subdirectory: %s\n' "${render_subdirectory_path}" >&2
      exit 78
    fi
  fi
done

# Render one owned deployment template and reject unresolved variables.
render_template() {
  local render_source=$1
  local render_target=$2
  local render_content
  local render_name
  render_content=$(<"${render_source}")
  for render_name in "${render_variables[@]}"; do
    render_content=${render_content//@${render_name}@/${!render_name}}
  done
  if [[ "${render_content}" =~ @[A-Z][A-Z0-9_]*@ ]]; then
    printf 'Unresolved placeholder in %s\n' "${render_source}" >&2
    exit 78
  fi
  printf '%s\n' "${render_content}" >"${render_target}"
}

install -d -m 0700 \
  "${RENDER_OUTPUT_DIR}/systemd" \
  "${RENDER_OUTPUT_DIR}/redis"
if [ ! -e "${render_output_marker}" ]; then
  install -m 0600 /dev/null "${render_output_marker}"
fi

render_template "${render_deploy_root}/templates/systemd/durisweb-production.service" \
  "${RENDER_OUTPUT_DIR}/systemd/durisweb-production.service"
render_template "${render_deploy_root}/templates/systemd/durisweb-redis.service" \
  "${RENDER_OUTPUT_DIR}/systemd/durisweb-redis.service"
render_template "${render_deploy_root}/templates/redis/redis.conf" \
  "${RENDER_OUTPUT_DIR}/redis/redis.conf"

if [ "${DEPLOY_CLOUDFLARED_ENABLED}" = 'true' ]; then
  render_template "${render_deploy_root}/templates/systemd/durisweb-cloudflared.service" \
    "${RENDER_OUTPUT_DIR}/systemd/durisweb-cloudflared.service"
fi

if [ "${DEPLOY_NGINX_ENABLED}" = 'true' ]; then
  install -d -m 0700 "${RENDER_OUTPUT_DIR}/nginx"
  render_template "${render_deploy_root}/templates/nginx/bootstrap.conf" \
    "${RENDER_OUTPUT_DIR}/nginx/bootstrap.conf"
  render_template "${render_deploy_root}/templates/nginx/production.conf" \
    "${RENDER_OUTPUT_DIR}/nginx/production.conf"
  if [ -n "${NGINX_CANONICAL_ORIGIN:-}" ]; then
    render_template "${render_deploy_root}/templates/nginx/canonical-redirect.conf" \
      "${RENDER_OUTPUT_DIR}/nginx/canonical-redirect.conf"
  fi
  chmod 0644 "${RENDER_OUTPUT_DIR}"/nginx/*.conf
fi

chmod 0600 "${RENDER_OUTPUT_DIR}/redis/redis.conf"
chmod 0644 "${RENDER_OUTPUT_DIR}"/systemd/*.service

render_public_health=''
render_ingress_service=''
render_ingress_service_scope=''
if [ "${DEPLOY_CLOUDFLARED_ENABLED}" = 'true' ]; then
  render_ingress_service='durisweb-cloudflared.service'
  render_ingress_service_scope=${DEPLOY_SERVICE_SCOPE}
elif [ "${DEPLOY_NGINX_ENABLED}" = 'true' ]; then
  render_ingress_service=${NGINX_SERVICE}
  render_ingress_service_scope='system'
fi
if [ "${DEPLOY_CLOUDFLARED_ENABLED}" = 'true' ] || [ "${DEPLOY_NGINX_ENABLED}" = 'true' ]; then
  render_public_health=${PUBLIC_HEALTH_URL}
fi
{
  printf 'NODE_BIN=%s\n' "${NODE_BIN}"
  printf 'DEPLOY_SERVICE_SCOPE=%s\n' "${DEPLOY_SERVICE_SCOPE}"
  printf 'APPLICATION_SERVICE=%s\n' "${APPLICATION_SERVICE}"
  printf 'CACHE_SERVICE=%s\n' "${CACHE_SERVICE}"
  printf 'INGRESS_SERVICE=%s\n' "${render_ingress_service}"
  printf 'INGRESS_SERVICE_SCOPE=%s\n' "${render_ingress_service_scope}"
  printf 'LOCAL_HEALTH_URL=%s\n' "${LOCAL_HEALTH_URL}"
  printf 'PUBLIC_HEALTH_URL=%s\n' "${render_public_health}"
} >"${RENDER_OUTPUT_DIR}/deployment-selection.env"
chmod 0644 "${RENDER_OUTPUT_DIR}/deployment-selection.env"
printf 'Rendered deployment files under %s\n' "${RENDER_OUTPUT_DIR}"
