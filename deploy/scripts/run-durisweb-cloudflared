#!/usr/bin/env bash
set -euo pipefail

: "${DEPLOYMENT_ENV_FILE:?Deployment environment file path is required}"
: "${CLOUDFLARED_BIN:?cloudflared binary path is required}"
: "${CLOUDFLARED_METRICS_ADDRESS:?cloudflared metrics address is required}"
: "${SERVICE_HOME:?Service home is required}"
: "${SERVICE_PATH:?Service PATH is required}"
: "${CLOUDFLARE_API_TOKEN:?Cloudflare API token is required}"
: "${CLOUDFLARE_ACCOUNT_ID:?Cloudflare account ID is required}"
: "${CLOUDFLARE_WEB_TUNNEL_ID:?Cloudflare website tunnel ID is required}"
: "${RUNTIME_DIRECTORY:?RUNTIME_DIRECTORY is required}"

cloudflared_bin=${CLOUDFLARED_BIN}
cloudflared_version_output="$("${cloudflared_bin}" version)"
if [[ ! "$cloudflared_version_output" =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
  echo "Unable to determine cloudflared version" >&2
  exit 78
fi

cloudflared_major="${BASH_REMATCH[1]}"
cloudflared_minor="${BASH_REMATCH[2]}"
cloudflared_patch="${BASH_REMATCH[3]}"
supports_token_file=false
if (( cloudflared_major > 2025 )) ||
  (( cloudflared_major == 2025 && cloudflared_minor > 4 )) ||
  (( cloudflared_major == 2025 && cloudflared_minor == 4 && cloudflared_patch >= 0 )); then
  supports_token_file=true
fi

if [[ -L "${DEPLOYMENT_ENV_FILE}" || ! -f "${DEPLOYMENT_ENV_FILE}" ]]; then
  echo "Unsafe or missing deployment environment file" >&2
  exit 78
fi

env_mode="$(stat -c '%a' "${DEPLOYMENT_ENV_FILE}")"
env_owner="$(stat -c '%u' "${DEPLOYMENT_ENV_FILE}")"
if (( (8#$env_mode & 0177) != 0 )) || [[ "$env_owner" != "$(id -u)" ]]; then
  echo "Deployment environment file must be owner-controlled with mode 0600" >&2
  exit 78
fi

runtime_dir=${RUNTIME_DIRECTORY}
if [[ "${runtime_dir}" != /* || -L "${runtime_dir}" || ! -d "${runtime_dir}" ]] ||
  [[ "$(stat -c '%u' "${runtime_dir}")" != "$(id -u)" ]] ||
  (( (8#$(stat -c '%a' "${runtime_dir}") & 0077) != 0 )); then
  echo 'Runtime directory must be an owner-only, non-symlink directory' >&2
  exit 78
fi
token_file="${runtime_dir}/token"

token_response="$({
  curl -fsS --connect-timeout 10 --max-time 30 \
    -H "Authorization: Bearer ${CLOUDFLARE_API_TOKEN}" \
    -H 'Content-Type: application/json' \
    "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/cfd_tunnel/${CLOUDFLARE_WEB_TUNNEL_ID}/token"
})"
tunnel_token="$(jq -er 'select(.success == true) | .result' <<<"$token_response")"

unset CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_WEB_TUNNEL_ID
unset token_response

cloudflared_args=(
  tunnel
  --no-autoupdate
  --metrics
  "${CLOUDFLARED_METRICS_ADDRESS}"
  --loglevel
  info
  run
)

if [[ "$supports_token_file" == true ]]; then
  umask 0077
  printf '%s' "$tunnel_token" >"$token_file"
  unset tunnel_token
  exec env -i \
    HOME="${SERVICE_HOME}" \
    PATH="${SERVICE_PATH}" \
    "$cloudflared_bin" "${cloudflared_args[@]}" --token-file "$token_file"
fi

# cloudflared releases before 2025.4.0 accept the token only through the
# inherited variable. Keep every other environment value out of the child.
rm -f "$token_file"
exec env -i \
  HOME="${SERVICE_HOME}" \
  PATH="${SERVICE_PATH}" \
  TUNNEL_TOKEN="$tunnel_token" \
  "$cloudflared_bin" "${cloudflared_args[@]}"
