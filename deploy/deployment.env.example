# Copy this file outside the repository, replace every placeholder, and keep it
# owner-readable only (mode 0600). It is the input to deploy/scripts/render-config.

RENDER_OUTPUT_DIR=/srv/example/durisweb-rendered
BACKEND_ROOT=/srv/example/durisweb/backend
FRONTEND_DIST=/srv/example/durisweb/frontend/dist
BACKEND_ENV_FILE=/etc/example-durisweb/backend.env
NODE_BIN=/usr/local/bin/node
TEST_BIN=/usr/bin/test
SERVICE_PATH=/usr/local/bin:/usr/bin:/bin
LOCAL_HEALTH_URL=http://127.0.0.1:3001/health
PUBLIC_HEALTH_URL=https://example.invalid/health

APPLICATION_SERVICE=durisweb-production.service
CACHE_SERVICE=durisweb-redis.service
DATABASE_SERVICE=example-database.service
MUD_SERVICE=example-mud.service

REDIS_BIN=/usr/bin/redis-server
REDIS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu
REDIS_CONFIG_PATH=/etc/example-durisweb/redis.conf
REDIS_DATA_DIR=/var/lib/example-durisweb-redis
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6380
REDIS_DATABASE_COUNT=1
REDIS_MAX_MEMORY=256mb

DEPLOY_CLOUDFLARED_ENABLED=false
DEPLOYMENT_ENV_FILE=/etc/example-durisweb/deployment.env
SERVICE_HOME=/srv/example
CLOUDFLARED_BIN=/usr/local/bin/cloudflared
CLOUDFLARED_LAUNCHER=/srv/example/durisweb/deploy/scripts/run-durisweb-cloudflared
CLOUDFLARED_METRICS_ADDRESS=127.0.0.1:20243

# Least-privilege scope: Account/Cloudflare Tunnel/Edit and Zone/DNS/Edit, restricted to this account and the app's DNS zone.
CLOUDFLARE_API_TOKEN=replace_with_scoped_api_token
CLOUDFLARE_ACCOUNT_ID=replace_with_account_id
CLOUDFLARE_WEB_TUNNEL_ID=replace_with_tunnel_id

DEPLOY_NGINX_ENABLED=false
NGINX_SERVICE=nginx.service
NGINX_HTTP_LISTEN=80
NGINX_HTTPS_LISTEN=443
NGINX_SERVER_NAMES=example.invalid www.example.invalid
NGINX_BACKEND_UPSTREAM=http://127.0.0.1:8080
NGINX_ACME_ROOT=/var/www/example-acme
NGINX_TLS_CERTIFICATE=/etc/ssl/example/fullchain.pem
NGINX_TLS_CERTIFICATE_KEY=/etc/ssl/example/privkey.pem
NGINX_TLS_OPTIONS_INCLUDE=/etc/ssl/example/options.conf
NGINX_TLS_DHPARAM=/etc/ssl/example/dhparams.pem
