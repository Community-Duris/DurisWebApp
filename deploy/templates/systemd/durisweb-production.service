[Unit]
Description=DurisWeb production API and static frontend
Wants=network-online.target @DATABASE_SERVICE@
Requires=@CACHE_SERVICE@
After=network-online.target @DATABASE_SERVICE@ @MUD_SERVICE@ @CACHE_SERVICE@
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
@SERVICE_IDENTITY@
Type=simple
WorkingDirectory=@BACKEND_ROOT@
EnvironmentFile=@BACKEND_ENV_FILE@
Environment=PATH=@SERVICE_PATH@
ExecStartPre=@TEST_BIN@ -r @BACKEND_ROOT@/dist/index.js
ExecStartPre=@TEST_BIN@ -r @FRONTEND_DIST@/index.html
ExecCondition=@TEST_BIN@ -d @BACKEND_ROOT@/migrations
ExecCondition=@NODE_BIN@ @BACKEND_ROOT@/dist/scripts/productionPreflight.js --configuration
ExecStartPre=@NODE_BIN@ @BACKEND_ROOT@/dist/scripts/productionPreflight.js --dependencies
ExecStart=@NODE_BIN@ @BACKEND_ROOT@/dist/index.js
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=90s
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RemoveIPC=@SERVICE_REMOVE_IPC@
RestrictSUIDSGID=true
# The administrative terminal uses bubblewrap's mount/user/IPC/UTS/cgroup namespaces.
# Keep PID and network namespace creation denied; the terminal shares both.
RestrictNamespaces=mnt user ipc uts cgroup
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=durisweb-production

[Install]
WantedBy=@SERVICE_INSTALL_TARGET@
