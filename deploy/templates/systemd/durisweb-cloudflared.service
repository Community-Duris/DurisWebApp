[Unit]
Description=Cloudflare Tunnel for DurisWeb production website
Wants=network-online.target
# Ordered after, but not bound to, the application: systemd stops a bound unit
# when the application restarts after a failure and never starts it again.
After=network-online.target @APPLICATION_SERVICE@
StartLimitIntervalSec=0

[Service]
@SERVICE_IDENTITY@
Type=simple
EnvironmentFile=@DEPLOYMENT_ENV_FILE@
ExecStart=@CLOUDFLARED_LAUNCHER@
# cloudflared can exit 0 after losing every edge connection, so restart after
# any exit except the launcher's configuration refusal.
Restart=always
RestartSec=5s
RestartPreventExitStatus=78
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=90s
TimeoutStopSec=45s
UMask=0077
LimitNOFILE=65535
RuntimeDirectory=durisweb-cloudflared
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=@SERVICE_REMOVE_IPC@
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=durisweb-cloudflared

[Install]
WantedBy=@SERVICE_INSTALL_TARGET@
