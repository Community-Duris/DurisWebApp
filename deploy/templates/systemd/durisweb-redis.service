[Unit]
Description=DurisWeb private Redis cache
Wants=network-online.target
After=network-online.target
Before=@APPLICATION_SERVICE@
StartLimitIntervalSec=0

[Service]
@SERVICE_IDENTITY@
Type=simple
EnvironmentFile=@BACKEND_ENV_FILE@
Environment=LD_LIBRARY_PATH=@REDIS_LIBRARY_PATH@
RuntimeDirectory=durisweb-redis
RuntimeDirectoryMode=0700
ExecStart="@BACKEND_ROOT@/../deploy/scripts/run-durisweb-redis" "@REDIS_BIN@" "@REDIS_CONFIG_PATH@"
Restart=always
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@REDIS_DATA_DIR@
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=@SERVICE_REMOVE_IPC@
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=durisweb-redis

[Install]
WantedBy=@SERVICE_INSTALL_TARGET@
